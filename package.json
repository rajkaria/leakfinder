{
  "name": "leakfinder",
  "version": "0.1.0",
  "description": "Finds the money leaking between Stripe and your database. The agent writes the queries, runs them in a sealed CreateOS sandbox, and the model never sees a customer row.",
  "type": "module",
  "license": "MIT",
  "author": "Raj Karia",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rajkaria/leakfinder.git"
  },
  "homepage": "https://github.com/rajkaria/leakfinder#readme",
  "keywords": [
    "stripe",
    "reconciliation",
    "revenue-leak",
    "ai-agent",
    "sandbox",
    "createos",
    "postgres",
    "billing"
  ],
  "bin": {
    "leakfinder": "bin/leakfinder.js"
  },
  "files": [
    "bin",
    "dist",
    "vm/server.py",
    "seed/schema.sql",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "lf": "tsx src/cli.ts",
    "check": "tsx src/cli.ts doctor",
    "seed": "tsx src/seed.ts",
    "seed:starter": "tsx src/starters/saas-starter.ts seed",
    "scan": "tsx src/cli.ts audit",
    "apply": "tsx src/cli.ts apply",
    "verify": "tsx src/verify.ts",
    "verify:starter": "tsx src/starters/saas-starter.ts verify",
    "demo": "tsx src/cli.ts demo",
    "serve": "tsx src/cli.ts serve",
    "report": "tsx src/cli.ts report",
    "spike": "tsx scripts/spike-sandbox.ts",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "down": "tsx src/cli.ts down",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm build && pnpm test",
    "rehearse": "tsx scripts/rehearse-offline.ts",
    "rehearse:starter": "tsx scripts/rehearse-starter.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@nodeops-createos/sandbox": "^0.8.2",
    "dotenv": "^18.0.8",
    "pg": "^8.23.1",
    "stripe": "^23.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.18.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
