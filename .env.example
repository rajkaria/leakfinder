# Names only; never commit values. `stripe projects env --pull` writes the provisioned ones.
# CreateOS sandbox API key (from `stripe projects add createos/...` or the CreateOS console).
CREATEOS_SANDBOX_API_KEY=
# Postgres connection string (Neon via `stripe projects add neon/postgres`); sslmode=require is fine.
DATABASE_URL=
# Stripe test-mode secret key (sk_test_... or rk_test_...). The audit reads every subscription in this account.
STRIPE_SECRET_KEY=
# The model that writes the code: set one key. It only ever sees code, schema, counts and errors.
# Put hand-added keys in .env.local: `stripe projects env --pull` rewrites .env.
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
# Optional: anthropic | deepseek (default: whichever key is set) and the model name.
LEAKFINDER_PROVIDER=
LEAKFINDER_MODEL=
# Optional: low | medium | high | xhigh | max. Lower is faster on stage (Claude only).
LEAKFINDER_EFFORT=
# Optional: 1 lets DeepSeek think before it answers. Off by default: much slower, and it can use up the reply budget.
LEAKFINDER_DEEPSEEK_THINKING=
# Optional: seconds of idle before the run's sandbox pauses itself (its report link wakes it). 0 = off.
LEAKFINDER_AUTOPAUSE=600
